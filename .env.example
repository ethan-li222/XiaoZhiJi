RESEARCH_DATA_DIR=./data
RESEARCH_MODEL_PROVIDER=api
RESEARCH_MODEL_NAME=qwen-plus
RESEARCH_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RESEARCH_MODEL_API_KEY=
# Alternative profile: remove the three RESEARCH_MODEL_* name/base/key lines above,
# then use SHANIU_API_BASE, SHANIU_API_KEY, SHANIU_MODEL instead.
# SHANIU_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2
# SHANIU_API_KEY=your-api-key
# SHANIU_MODEL=xopglm53
# Optional explicit reference to an existing dotenv file (not loaded by default):
# RESEARCH_CREDENTIALS_FILE=../.env
# RESEARCH_MODEL_API_KEY_ENV=GLM_API_Key
RESEARCH_MODEL_TIMEOUT=90
RESEARCH_MODEL_MAX_TOKENS=8192
RESEARCH_MODEL_EXTRA_BODY={}
# Ollama: set provider=ollama, model_name to an installed model,
# and model_base_url=http://localhost:11434
RESEARCH_OPENALEX_API_KEY=
RESEARCH_SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_TOOL_TRANSPORT=stdio
RESEARCH_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RESEARCH_EMBEDDING_DIR=./data/embedding-model
RESEARCH_BROWSER_ENABLED=false
# Optional full path to Chrome; npm.cmd is resolved automatically on Windows.
RESEARCH_CHROME_PATH=
# Private shared workspace. Run `research-agent access-init` to generate a token.
RESEARCH_ACCESS_TOKEN=
RESEARCH_SECURE_COOKIES=false
RESEARCH_MAX_REQUEST_BYTES=2000000
RESEARCH_MAX_UPLOAD_BYTES=50000000
RESEARCH_MAX_PARALLEL_TASKS=3
